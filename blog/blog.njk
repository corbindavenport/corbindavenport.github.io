---
title: Blog Posts
permalink: "blog/index.html"
---

{% for post in collections.post | reverse %}
    <p>
    <b><a href="{{post.url}}">{{ post.data.title }}</a></b> - {{ post.date | shortDate }}
    {% if "snippet" in post.data %}
        <br />{{ post.data.snippet }}
    {% endif %}
    </p>
{% endfor %}