---
title: Blog Posts
permalink: "blog/index.html"
---

<p><i>This migration is still a work in progress!</i></p>

{% for post in collections.post | reverse %}
    <h3>
        <a href="{{post.url}}">{{ post.data.title }}</a>
    </h3>
    <p><i>{{ post.date | longDate }}</i></p>
    <p>{{ post.data.excerpt if post.data.excerpt else (post.content | excerptFallback) }}</p>
{% endfor %}